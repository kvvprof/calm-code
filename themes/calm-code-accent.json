  "semanticTokenColors": {
    "variable": "#D4D4D4",
    "parameter": "#D4D4D4",
    "property": "#D1C099",
    "property.declaration": "#D1C099",
    "type": "#D98C8C",
    "typeParameter": "#D98C8C",
    "function": "#8DA8D2",
    "method": "#8DA8D2",
    "class": "#D98C8C",
    "interface": "#D98C8C",
    "enum": "#D98C8C",
    "enumMember": "#D98C8C",
    "namespace": "#D98C8C",
    "decorator": "#8DA8D2",
    "event": "#8DA8D2",
    "regexp": "#5FB3B3",
    "string": "#99C794",
    "number": "#F99157",
    "boolean": "#F99157",
    "keyword": "#C594C5",
    "comment": "#7F7F7F",
    "operator": "#5FB3B3",
    "macro": "#8DA8D2",
    "label": "#D4D4D4",
    "variable.readonly": "#D4D4D4",
    "property.readonly": "#D1C099",
    "function.declaration": "#8DA8D2",
    "method.declaration": "#8DA8D2",
    "class.declaration": "#D98C8C",
    "type.declaration": "#D98C8C",
    "parameter.declaration": "#D4D4D4",
    "variable.declaration": "#D4D4D4"
  },
  "tokenColors": [
    {
      "name": "Declarations, Storage, Control",
      "scope": [
        "storage.modifier",
        "keyword.declaration",
        "keyword.other",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#C594C5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Functions, Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#8DA8D2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "variable.other.constant",
        "meta.definition.variable variable.other",
        "meta.variable.declaration variable.other",
        "meta.variable.assignment variable.other"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "Classes, Types, Decorators, Annotations",
      "scope": [
        "variable.language.this",
        "variable.language.super",
        "variable.language.self",
        "keyword.operator.new",
        "keyword.other.new",
        "keyword.control.new",
        "storage.type.new",
        "entity.name.type.interface",
        "entity.name.type.enum",
        "entity.name.type",
        "support.class",
        "entity.name.function.decorator",
        "storage.type.annotation",
        "punctuation.definition.decorator",
        "punctuation.definition.annotation",
        "meta.annotation.identifier",
        "meta.decorator variable.other.readwrite",
        "meta.decorator entity.name.function",
        "meta.function.decorator entity.name.function",
        "meta.function.decorator.python entity.name.function"
      ],
      "settings": {
        "foreground": "#D98C8C"
      }
    },
    {
      "name": "Type Annotations",
      "scope": [
        "meta.type",
        "meta.type.annotation",
        "meta.type.declaration",
        "meta.return.type",
        "meta.type entity.name.type",
        "meta.type.annotation entity.name.type",
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type"
      ],
      "settings": {
        "foreground": "#D98C8C"
      }
    },
    {
      "name": "Strings",
      "scope": ["string", "markup.inline.raw"],
      "settings": {
        "foreground": "#99C794"
      }
    },
    {
      "name": "Numbers, Constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "support.constant",
        "constant.character",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#F99157"
      }
    },
    {
      "name": "Booleans, Null",
      "scope": [
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#F99157"
      }
    },
    {
      "name": "Import, Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from"
      ],
      "settings": {
        "foreground": "#C594C5"
      }
    },
    {
      "name": "Object, JSON, YAML",
      "scope": [
        "meta.object-literal.key",
        "support.type.property-name",
        "meta.structure.dictionary.json support.type.property-name.json",
        "entity.name.tag.yaml",
        "meta.key.yaml"
      ],
      "settings": {
        "foreground": "#D4D4D4"
      }
    },
    {
      "name": "JSX/TSX Props",
      "scope": [
        "source.js.jsx entity.other.attribute-name",
        "source.jsx entity.other.attribute-name",
        "source.tsx entity.other.attribute-name",
        "meta.tag.jsx entity.other.attribute-name",
        "meta.tag.tsx entity.other.attribute-name",
        "meta.tag.attributes.jsx entity.other.attribute-name",
        "meta.tag.attributes.tsx entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C9A8C6"
      }
    },
    {
      "name": "Object Property Keys",
      "scope": ["support.type.property-name", "meta.object-literal.key"],
      "settings": {
        "foreground": "#D1C099"
      }
    },
    {
      "name": "HTML/CSS Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.css",
        "entity.other.attribute-name",
        "entity.other.attribute-name.id.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#F0969E"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "constant.character.escape",
        "string.regexp.group",
        "string.regexp.arbitrary-repetition"
      ],
      "settings": {
        "foreground": "#5FB3B3"
      }
    },
    {
      "name": "Invalid, Deprecated",
      "scope": ["invalid", "invalid.deprecated"],
      "settings": {
        "foreground": "#E15A60",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#7F7F7F"
      }
    }
  ]
}
